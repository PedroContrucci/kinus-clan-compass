# Credenciais do Supabase externo (projeto kinu-beta) usadas por
# scripts/sync-catalog.ts para ler a tabela curated_activities.
# Copie este arquivo para .env.sync (git-ignorado) e preencha os valores.

# URL base do projeto Supabase, ex.: https://xxxxxxxx.supabase.co
KINU_BETA_URL=

# Service role key (secreta — dá acesso total; nunca commitar)
KINU_BETA_SERVICE_KEY=
