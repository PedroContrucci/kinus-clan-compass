# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Compiled JS artifacts in src/data/ shadow the .ts source: Vite resolves
# .js before .ts for extensionless imports, so a stale .js silently overrides
# the real catalog. Keep these out of the repo.
src/data/*.js

